DATABASE_URL=mysql+pymysql://motranscript:motranscript@127.0.0.1:3307/motranscript
SECRET_KEY=change-me-in-production
HF_TOKEN=

# Inference: local (Mac) or runpod (VPS prod)
INFERENCE_BACKEND=local
# PUBLIC_BASE_URL=https://asr.example.com
# RUNPOD_API_KEY=
# RUNPOD_ENDPOINT_ID=
# RUNPOD_JOB_TIMEOUT_SEC=2400

# RunPod (LoRA training — optional until first paid run)
# MOTRANSCRIPT_GIT_URL=https://github.com/YOURUSER/motranscript.git
# RUNPOD_VOLUME_ID=
# Optional: explicit Node path for yt-dlp YouTube JS challenges (if worker PATH lacks node)
# YT_DLP_NODE_PATH=/opt/homebrew/bin/node
# Optional: Netscape cookies.txt so YouTube accepts datacenter IPs (VPS)
# YT_DLP_COOKIES=./secrets/youtube.cookies.txt
# Pause ASR while still ingesting YouTube/audio (worker downloads first)
# TRANSCRIBE_ENABLED=true
DATA_DIR=./data
MODEL_CACHE_DIR=./data/models
WHISPER_MODEL=Systran/faster-whisper-large-v3
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8

# Optional: LLM pass for out-of-lexicon Kreol spelling (OpenAI-compatible API)
# OPENAI_API_KEY=
# LORTOGRAF_LLM_BASE_URL=https://api.openai.com/v1
# LORTOGRAF_LLM_MODEL=gpt-4o-mini
# LORTOGRAF_USE_LLM=false
