# Production secrets — copy to /opt/motranscript/.env on the VPS (never commit).

MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_PASSWORD=change-me-app
SECRET_KEY=change-me-long-random
HF_TOKEN=

DATABASE_URL=mysql+pymysql://motranscript:change-me-app@db:3306/motranscript
DATA_DIR=/data
MODEL_CACHE_DIR=/data/models
WHISPER_MODEL=Systran/faster-whisper-large-v3

# Prod: RunPod Serverless (no local GPU)
INFERENCE_BACKEND=runpod
PUBLIC_BASE_URL=https://asr.example.com
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
RUNPOD_JOB_TIMEOUT_SEC=2400
# Image pulled by RunPod (not the VPS): ghcr.io/YOUR_GITHUB_USER/motranscript-asr:v1
# Do not put a GHCR / GitHub packages token here.

ENABLE_DIARIZATION=true
# Pause ASR while batch-downloading (worker still runs ingest):
# TRANSCRIBE_ENABLED=false

# YouTube bot check on VPS IPs — export cookies from a logged-in browser, then:
#   mkdir -p /opt/motranscript/secrets
#   scp youtube.cookies.txt YOUR_VPS_USER@YOUR_VPS_HOST:/opt/motranscript/secrets/youtube.cookies.txt
# YT_DLP_COOKIES=/secrets/youtube.cookies.txt
