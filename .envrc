# Always use this project's uv virtualenv, not a global pyenv env (e.g. lewagon).
# After creating/editing: run `direnv allow` once in this folder.

if [[ ! -d .venv ]]; then
  echo "motranscript: creating .venv via uv…"
  uv sync --extra pipeline --extra dev
fi

# Prefer project .venv over any active pyenv virtualenv
unset PYENV_VERSION
export VIRTUAL_ENV="$PWD/.venv"
PATH_add "$PWD/.venv/bin"

# Keep shell prompt honest if something still reads pyenv
export VIRTUAL_ENV_PROMPT="motranscript"
